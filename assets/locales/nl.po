msgstr "Aanvaarden"

#. Considering
msgid "Prompt/mood/considering"
msgstr "Overwegend"

#. Pleased
msgid "Prompt/mood/pleased"
msgstr "Voldaan"

#. Gracious
msgid "Prompt/mood/gracious"
msgstr "Genadig"

#. Calculating
msgid "Prompt/mood/calculating"
msgstr "Berekenend"

#. Skeptical
msgid "Prompt/mood/skeptical"
msgstr "Sceptisch"

#. Impatient
msgid "Prompt/mood/impatient"
msgstr "Ongeduldig"

#. Irritated
